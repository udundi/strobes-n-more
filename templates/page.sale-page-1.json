    "dynamic_custom_liquid_7AWjbd": {
      "type": "dynamic-custom-liquid",
      "disabled": true,
      "custom_css": [
        "{margin-top: -30px;}"
      ],
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "custom_liquid": "{% comment %}\nShopify Countdown Timer\nUsage: Include this in your theme template and set the target date\n{% endcomment %}\n\n{% assign target_date = '2025-12-02T00:00:00' %}\n{% assign current_date = 'now' | date: '%s' %}\n{% assign target_timestamp = target_date | date: '%s' %}\n\n<div class=\"custom-countdown-wrapper\">\n  <div class=\"custom-countdown-display\" data-target-date=\"{{ target_date }}\">\n    <h2 class=\"custom-countdown-heading\">Sale will end in</h2>\n    <div class=\"custom-countdown-row\">\n    <div class=\"custom-countdown-block\">\n      <div class=\"custom-countdown-digit\" id=\"custom-days\">0</div>\n      <div class=\"custom-countdown-text\">DAYS</div>\n    </div>\n    <div class=\"custom-countdown-divider\"></div>\n    <div class=\"custom-countdown-block\">\n      <div class=\"custom-countdown-digit\" id=\"custom-hours\">0</div>\n      <div class=\"custom-countdown-text\">HOURS</div>\n    </div>\n    <div class=\"custom-countdown-divider\"></div>\n    <div class=\"custom-countdown-block\">\n      <div class=\"custom-countdown-digit\" id=\"custom-minutes\">0</div>\n      <div class=\"custom-countdown-text\">MINUTES</div>\n    </div>\n    <div class=\"custom-countdown-divider\"></div>\n    <div class=\"custom-countdown-block\">\n      <div class=\"custom-countdown-digit\" id=\"custom-seconds\">0</div>\n      <div class=\"custom-countdown-text\">SECONDS</div>\n    </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.custom-countdown-wrapper {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 20px;\n}\n\n.custom-countdown-display {\n  background: #21225b;\n  border: 2px solid rgba(255, 255, 255, 0.2);\n  border-radius: 0;\n  padding: 20px 20px 30px 20px;\n  position: relative;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n}\n\n.custom-countdown-heading {\n  text-align: center;\n  font-size: 1.8rem;\n  font-weight: 800;\n  color: white !important;\n  margin: 0 0 35px 0;\n  font-family: 'Montserrat', 'Arial', sans-serif;\n  font-style: normal;\n}\n\n.custom-countdown-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.custom-countdown-block {\n  flex: 1;\n  text-align: center;\n  color: white;\n}\n\n.custom-countdown-digit {\n  font-size: 3rem;\n  font-weight: 700;\n  line-height: 1;\n  margin-bottom: 8px;\n  font-family: 'Arial', sans-serif;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);\n}\n\n.custom-countdown-text {\n  font-size: 0.9rem;\n  font-weight: 500;\n  letter-spacing: 2px;\n  opacity: 0.9;\n  font-family: 'Nunito Sans', 'Arial', sans-serif;\n}\n\n.custom-countdown-divider {\n  width: 2px;\n  height: 60px;\n  background: rgba(255, 255, 255, 0.3);\n  margin: 0 15px;\n}\n\n/* Responsive Design */\n@media (max-width: 768px) {\n  .custom-countdown-display {\n    padding: 20px 15px;\n  }\n  \n  .custom-countdown-digit {\n    font-size: 2.5rem;\n  }\n  \n  .custom-countdown-text {\n    font-size: 0.8rem;\n    letter-spacing: 1px;\n  }\n  \n  .custom-countdown-divider {\n    height: 50px;\n    margin: 0 10px;\n  }\n}\n\n@media (max-width: 480px) {\n  .custom-countdown-display {\n    padding: 15px 10px;\n  }\n  \n  .custom-countdown-digit {\n    font-size: 2rem;\n  }\n  \n  .custom-countdown-text {\n    font-size: 0.7rem;\n  }\n  \n  .custom-countdown-divider {\n    height: 40px;\n    margin: 0 8px;\n  }\n}\n\n/* Animation for number changes */\n.custom-countdown-digit {\n  transition: transform 0.3s ease;\n}\n\n.custom-countdown-digit.updating {\n  transform: scale(1.1);\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const customCountdownTimer = document.querySelector('.custom-countdown-display');\n  const targetDate = customCountdownTimer.getAttribute('data-target-date');\n  \n  function updateCustomCountdown() {\n    const now = new Date().getTime();\n    const target = new Date(targetDate).getTime();\n    const difference = target - now;\n    \n    console.log('Target Date:', targetDate); // Debug log\n    console.log('Time Difference:', difference); // Debug log\n    \n    if (difference > 0) {\n      const days = Math.floor(difference / (1000 * 60 * 60 * 24));\n      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));\n      const seconds = Math.floor((difference % (1000 * 60)) / 1000);\n      \n      // Add animation class when updating\n      const daysEl = document.getElementById('custom-days');\n      const hoursEl = document.getElementById('custom-hours');\n      const minutesEl = document.getElementById('custom-minutes');\n      const secondsEl = document.getElementById('custom-seconds');\n      \n      if (daysEl.textContent !== days.toString()) {\n        daysEl.classList.add('updating');\n        setTimeout(() => daysEl.classList.remove('updating'), 300);\n      }\n      if (hoursEl.textContent !== hours.toString()) {\n        hoursEl.classList.add('updating');\n        setTimeout(() => hoursEl.classList.remove('updating'), 300);\n      }\n      if (minutesEl.textContent !== minutes.toString()) {\n        minutesEl.classList.add('updating');\n        setTimeout(() => minutesEl.classList.remove('updating'), 300);\n      }\n      if (secondsEl.textContent !== seconds.toString()) {\n        secondsEl.classList.add('updating');\n        setTimeout(() => secondsEl.classList.remove('updating'), 300);\n      }\n      \n      daysEl.textContent = days;\n      hoursEl.textContent = hours;\n      minutesEl.textContent = minutes;\n      secondsEl.textContent = seconds;\n    } else {\n      // Countdown finished\n      document.getElementById('custom-days').textContent = '0';\n      document.getElementById('custom-hours').textContent = '0';\n      document.getElementById('custom-minutes').textContent = '0';\n      document.getElementById('custom-seconds').textContent = '0';\n      \n      // Optional: Add expired state\n      customCountdownTimer.classList.add('custom-expired');\n    }\n  }\n  \n  // Update immediately\n  updateCustomCountdown();\n  \n  // Update every second\n  const customInterval = setInterval(updateCustomCountdown, 1000);\n  \n  // Clean up interval when page unloads\n  window.addEventListener('beforeunload', function() {\n    clearInterval(customInterval);\n  });\n});\n</script>\n\n{% comment %}\nInstructions for customization:\n\n1. Change the target date:\n   Modify the target_date variable at the top:\n   {% assign target_date = '2025-12-31T23:59:59' %}\n\n2. To use a specific product launch date, you can use:\n   {% assign target_date = product.created_at | date: '%Y-%m-%dT%H:%M:%S' %}\n\n3. For a sale end date, you can use:\n   {% assign target_date = '2025-07-01T00:00:00' %}\n\n4. To customize colors, modify the CSS:\n   - Background gradient: background: linear-gradient(135deg, #2a2d7a 0%, #1a1d4a 100%);\n   - Border color: border: 2px solid rgba(255, 255, 255, 0.2);\n   - Text color: color: white;\n\n5. To add this to your theme:\n   - Create a new snippet file: countdown-timer.liquid\n   - Include it in your template: {% include 'countdown-timer' %}\n   - Or add directly to your template file\n\n6. Optional: Add expired state styling by adding this CSS:\n   .custom-countdown-display.custom-expired {\n     background: #666;\n   }\n   .custom-countdown-display.custom-expired .custom-countdown-digit {\n     color: #ccc;\n   }\n{% endcomment %}"
      }
    },
