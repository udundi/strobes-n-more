      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"Virginia Emergency Vehicle Light Laws: Four Light Units and Purple Authorization\",\n  \t\"description\": \"Va. Code 46.2-1024 now allows four warning light units on a volunteer POV, not two. Plus purple lights and Superintendent approval. Reviewed September 2026.\",\n  \t\"abstract\": \"Virginia Code § 46.2-1024 permits any member of a fire department, volunteer fire company, or volunteer emergency medical services agency, and any police chaplain, to equip one vehicle owned by that person with no more than four flashing or steady-burning red or red and white combination warning light units of types approved by the Superintendent. The Virginia limit is now four warning light units, not two. Guidance stating a two-unit maximum reflects a superseded version of § 46.2-1024 before it was amended to increase the number of units. Warning light units permitted by Virginia Code § 46.2-1024 shall be lit only when answering emergency calls. Virginia authorizes purple warning lights. Section 46.2-1025 is titled \\\"Flashing amber, purple, or green warning lights,\\\" making Virginia one of a small number of states with an express purple authorization. Virginia conditions warning equipment on type approval. Sections 46.2-1023 through 46.2-1029 repeatedly require lights to be of types approved by the Superintendent of State Police, so color compliance alone does not establish legality. Virginia Code § 46.2-1026 requires high-intensity flashing, blinking or alternating amber warning lights visible for at least 500 feet, of types approved by the Superintendent, on the vehicles that section covers.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-08-DD\",\n  \t\"dateModified\": \"2026-08-DD\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"Virginia emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"Va. Code §§ 46.2-1023 to 46.2-1029.2\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"Virginia\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-VA\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Code of Virginia § 46.2-1024 (Virginia Law Portal)\",\n      \t\"url\": \"https://law.lis.virginia.gov/vacode/title46.2/chapter10/section46.2-1024/\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Code of Virginia Title 46.2, Chapter 10, Article 3, Lights and Turn Signals\",\n      \t\"url\": \"https://law.lis.virginia.gov/vacodefull/title46.2/chapter10/article3/\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Virginia Department of State Police\",\n      \t\"url\": \"https://vsp.virginia.gov/\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 630\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#webpage\",\n  \t\"url\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws\",\n  \t\"name\": \"Virginia Emergency Vehicle Light Laws (2026 Guide)\",\n  \t\"description\": \"Va. Code 46.2-1024 now allows four warning light units on a volunteer POV, not two. Plus purple lights and Superintendent approval. Reviewed September 2026.\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/#website\"\n  \t},\n  \t\"breadcrumb\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#breadcrumb\"\n  \t},\n  \t\"lastReviewed\": \"2026-08-DD\",\n  \t\"reviewedBy\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"inLanguage\": \"en-US\"\n\t},\n\t{\n  \t\"@type\": \"BreadcrumbList\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#breadcrumb\",\n  \t\"itemListElement\": [\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 1,\n      \t\"name\": \"Home\",\n      \t\"item\": \"https://strobesnmore.com/\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 2,\n      \t\"name\": \"Informative Blogs\",\n      \t\"item\": \"https://strobesnmore.com/blogs/informative\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 3,\n      \t\"name\": \"Virginia Emergency Vehicle Light Laws\"\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"FAQPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/virginia-emergency-vehicle-light-laws#faq\",\n  \t\"mainEntity\": [\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"How many warning lights can a volunteer firefighter have in Virginia?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Up to four. Virginia Code § 46.2-1024 permits a member of a fire department, volunteer fire company or volunteer emergency medical services agency, and any police chaplain, to equip one vehicle owned by that person with no more than four flashing or steady-burning red or red and white combination warning light units of types approved by the Superintendent. Guidance stating two units reflects an earlier version of the statute.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"When can Virginia volunteer warning lights be used?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Virginia Code § 46.2-1024 provides that warning light units permitted by that section shall be lit only when answering emergency calls.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Are purple lights legal in Virginia?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Virginia Code § 46.2-1025 is titled \\\"Flashing amber, purple, or green warning lights,\\\" making Virginia one of a small number of states with an express purple warning light authorization. As with other lights in the article, the equipment must be of a type approved by the Superintendent.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Does Virginia require approved equipment types?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Yes. Sections 46.2-1023 through 46.2-1029 repeatedly require warning lights to be of types approved by the Superintendent of State Police, so selecting the correct color is not by itself sufficient for compliance.\"\n      \t}\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"Organization\",\n  \t\"@id\": \"https://strobesnmore.com/#organization\",\n  \t\"name\": \"Strobes N' More\",\n  \t\"url\": \"https://strobesnmore.com/\",\n  \t\"telephone\": \"+1-401-454-4487\",\n  \t\"email\": \"sales@strobesnmore.com\",\n  \t\"address\": {\n    \t\"@type\": \"PostalAddress\",\n    \t\"streetAddress\": \"81 Tom Harvey Road\",\n    \t\