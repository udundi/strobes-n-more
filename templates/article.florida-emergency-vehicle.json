      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/florida-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/florida-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/florida-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"Florida Emergency Vehicle Light Laws: The New Blue Light Rule for Fire Apparatus\",\n  \t\"description\": \"Florida Statute 316.2397 now permits blue on large government fire apparatus. Colors by class plus volunteer red light rules. Reviewed September 2026.\",\n  \t\"abstract\": \"Florida Statute § 316.2397 was amended by Chapter 2024-29, Laws of Florida, to permit blue lights on certain fire department vehicles. The long-standing rule that blue was reserved to police vehicles in Florida is no longer a complete statement of the law. Under Florida Statute § 316.2397(2)(b), government-owned fire department vehicles, excluding vehicles of the fire patrol or volunteer fire departments, with a gross vehicle weight rating of more than 24,000 pounds may display blue lights if authorized in writing by the fire chief of the government agency and if displayed only on the rear of the vehicle. Florida Statute § 316.2397(1) prohibits driving or moving any vehicle displaying a red, red and white, or blue light visible from directly in front of the vehicle, except for the vehicles provided for in that section. Vehicles of the fire department and fire patrol in Florida, including vehicles of volunteer firefighters as permitted under § 316.2398, may show or display red or red and white lights. Under Florida Statute § 316.2398(5), a member of a volunteer fire department who uses red lights in violation of that section must be dismissed from the department. Florida wreckers, mosquito control fog and spray vehicles, and emergency vehicles of governmental departments or public service corporations may display amber lights when in actual operation or when a hazard exists, but not while traveling to or from the operation.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-09-08\",\n  \t\"dateModified\": \"2026-09-08\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"Florida emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"Fla. Stat. §§ 316.2397, 316.2398\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"Florida\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-FL\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Florida Statute § 316.2397 (Florida Senate)\",\n      \t\"url\": \"https://www.flsenate.gov/Laws/Statutes/2025/0316.2397\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Florida Statute § 316.2397 (Florida House of Representatives)\",\n      \t\"url\": \"https://www.flhouse.gov/Statutes/2025/0316.2397/\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Florida Statute § 316.2398, volunteer firefighter and medical staff warning signals\",\n      \t\"url\": \"https://www.flsenate.gov/Laws/Statutes/2025/316.2398\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 63