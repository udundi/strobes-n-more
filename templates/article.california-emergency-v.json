      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"California Emergency Vehicle Light Laws: The Steady Red Rule and Warning Lamp Classes\",\n  \t\"description\": \"CVC 25252 through 25269 by class, plus the 13 CCR 818 warning lamp classes that decide which equipment is actually legal. Reviewed September 2026.\",\n  \t\"abstract\": \"California Vehicle Code § 25252 requires every authorized emergency vehicle to be equipped with at least one steady burning red warning lamp visible from at least 1,000 feet to the front of the vehicle. Blue warning lamps in California are restricted. Under 13 CCR § 818(d), the additional flashing or steady burning blue warning lamp permitted by Vehicle Code § 25258(b) applies to police vehicles and must be a Class B, C or E warning lamp. California Vehicle Code § 25269 prohibits displaying a flashing or steady burning red warning light on a vehicle except as permitted by § 21055 or when an extreme hazard exists. California Vehicle Code § 25268 prohibits displaying a flashing amber warning light except when an unusual traffic hazard exists, which is narrower than the general amber allowances in most states. Flashing amber warning lamps are required on California tow cars by Vehicle Code § 25253, and under 13 CCR § 818(e) that lamp must be a Class B, C or E warning lamp. California regulates warning lamps by class as well as by color. Title 13 of the California Code of Regulations § 818 assigns Class A, B, C or E designations depending on the vehicle type and the directions in which the lamp is displayed.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-08-DD\",\n  \t\"dateModified\": \"2026-08-DD\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"California emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"Cal. Veh. Code §§ 25252-25269; 13 CCR § 818\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"California\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-CA\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"California Vehicle Code Article 7, Flashing and Colored Lights (California Legislative Information)\",\n      \t\"url\": \"https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=VEH&sectionNum=25252.\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"CHP 884, Warning Lamps for Authorized Emergency Vehicles and Special Hazard Vehicles\",\n      \t\"url\": \"https://www.chp.ca.gov/siteassets/forms/chp884.pdf\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"13 CCR § 818, Type of Warning Lamps Used on Emergency Vehicles and Special Hazard Vehicles\",\n      \t\"url\": \"https://www.law.cornell.edu/regulations/california/13-CCR-818\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 630\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#webpage\",\n  \t\"url\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws\",\n  \t\"name\": \"California Emergency Vehicle Light Laws (2026 Guide)\",\n  \t\"description\": \"CVC 25252 through 25269 by class, plus the 13 CCR 818 warning lamp classes that decide which equipment is actually legal. Reviewed September 2026.\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/#website\"\n  \t},\n  \t\"breadcrumb\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#breadcrumb\"\n  \t},\n  \t\"lastReviewed\": \"2026-08-DD\",\n  \t\"reviewedBy\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"inLanguage\": \"en-US\"\n\t},\n\t{\n  \t\"@type\": \"BreadcrumbList\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#breadcrumb\",\n  \t\"itemListElement\": [\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 1,\n      \t\"name\": \"Home\",\n      \t\"item\": \"https://strobesnmore.com/\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 2,\n      \t\"name\": \"Informative Blogs\",\n      \t\"item\": \"https://strobesnmore.com/blogs/informative\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 3,\n      \t\"name\": \"California Emergency Vehicle Light Laws\"\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"FAQPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/california-emergency-vehicle-light-laws#faq\",\n  \t\"mainEntity\": [\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Are blue lights illegal in California?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Blue warning lamps in California are restricted. The additional flashing or steady burning blue warning lamp is permitted under Vehicle Code § 25258(b), and 13 CCR § 818(d) treats it as a permitted blue warning lamp on police vehicles, requiring Class B, C or E. There is no volunteer firefighter, volunteer EMS or security blue authorization in California.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Does California require a steady red light on emergency vehicles?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Yes. Vehicle Code § 25252 requires every authorized emergency vehicle to be equipped with at least one steady burning red warning lamp visible from at least 1,000 feet to the front of the vehicle.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Do California tow trucks need amber lights?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Yes. Vehicle Code § 25253 makes a flashing yellow warning lamp a required lamp on tow cars, displayed to the front, sides or rear. Under 13 CCR § 818(e) it must be a Class B, C or E warning lamp.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"What are California warning lamp classes?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Title 13 of the California Code of Regulations § 818 assigns Class A, B, C or E designations to warning lamps depending on the vehicle type and the directions in which the lamp is displayed. Color alone does not determine whether a lamp is legal for a given application.\"\n      \t}\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"Organization\",\n  \t\"@id\": \"https://strobesnmore.com/#organization\",\n  \t\"name\": \"Strobes N' More\",\n  \t\"url\": \"https://strobesnmore.com/\",\n  \t\"telephone\": \"+1-401-454-4487\",\n  \t\"email\": \"sales@strobesnmore.com\",\n  \t\"address\": {\n    \t\"@type\": \"PostalAddress\",\n    \t\"streetAddress\": \"81 Tom Harvey Road\",\n  