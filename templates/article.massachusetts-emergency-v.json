      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/massachusetts-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/massachusetts-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/massachusetts-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"Massachusetts Emergency Vehicle Light Laws: The Chapter 90 Section 7E Permit System\",\n  \t\"description\": \"M.G.L. c. 90 s. 7E explained: who qualifies for a red or blue light permit, RMV application rules, carry requirements and penalties. Reviewed August 2026.\",\n  \t\"abstract\": \"In Massachusetts, authority to display a red warning light comes from a written permit issued by the Registrar of Motor Vehicles under M.G.L. c. 90, § 7E. The head of the fire department applies; the individual does not self-apply. Massachusetts requires the permit to be carried on the operator's person or in the vehicle in an easily accessible place whenever authorized red lights are mounted. Roles eligible for a red light permit under M.G.L. c. 90, § 7E include forest wardens and deputy forest wardens, municipal fire chiefs and deputy chiefs, municipal fire chaplains, members and call members of town fire departments, members and call members of emergency medical services, and Department of Fire Services employees and contractors. Blue light authority in Massachusetts is tied to law enforcement affiliation and is not available to volunteer fire or EMS members, unlike neighboring Connecticut where blue is the volunteer firefighter color. Massachusetts red lights may be displayed only when proceeding to a fire or responding to an alarm and when official duty requires it, and at no other time. Violations of M.G.L. c. 90, § 7E carry a fine of not less than $100 and not more than $300 where no other penalty is provided, in addition to permit revocation.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-09-08\",\n  \t\"dateModified\": \"2026-09-09\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"Massachusetts emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"M.G.L. c. 90, § 7E\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"Massachusetts\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-MA\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"M.G.L. c. 90, § 7E (Massachusetts Legislature)\",\n      \t\"url\": \"https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXIV/Chapter90/Section7E\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Mass.gov summary of c. 90 § 7E\",\n      \t\"url\": \"https://www.mass.gov/info-details/mass-general-laws-c90-ss-7e\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Massachusetts Registry of Motor Vehicles\",\n      \t\"url\": \"https://www.mass.gov/orgs/massachusetts-registry-of-motor-vehicles\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 630\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/massachusetts-emergency-vehicle-light-laws#webpage\",\n  \t\"url\