      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"Texas Emergency Vehicle Light Laws: Color by Class, Volunteer POVs and Security Patrol Green\",\n  \t\"description\": \"Transportation Code 547.305 and 547.702 by class, plus the HB 2812 rule limiting security patrol vehicles to green, amber or white. Reviewed September 2026.\",\n  \t\"abstract\": \"Texas Transportation Code § 547.305(b) prohibits any vehicle other than a police vehicle from displaying a red light visible from directly in front of the center of the vehicle, except as expressly authorized by law. Under Texas Transportation Code § 547.305(c), a person may not operate a motor vehicle equipped with a red, white or blue beacon, flashing or alternating light unless the equipment is used as specifically authorized by Chapter 547. HB 2812 of the 85th Texas Legislature amended § 547.305 to limit security patrol vehicles to green, amber or white lights. Security operators in Texas may not use red, white and blue emergency configurations. The private vehicle of a volunteer firefighter or a certified emergency medical services employee or volunteer in Texas may be equipped with warning lights when responding to a fire alarm or medical emergency, under Texas Transportation Code § 547.305(d). Texas Transportation Code § 546.004(a) provides that a volunteer firefighter operating a private vehicle as an authorized emergency vehicle may engage in the conduct permitted by § 546.001 only while using visual signals meeting the requirements of §§ 547.305 and 547.702. Texas tow trucks may display alternately flashing lighting equipment while under the direction of a law enforcement officer at the scene of a collision, while hooking up to a disabled vehicle on a roadway, or when fitted with a mounted light bar that also carries turn signals and stop lamps.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-09-08\",\n  \t\"dateModified\": \"2026-09-08\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"Texas emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"Tex. Transp. Code §§ 547.305, 547.702, 546.004\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"Texas\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-TX\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Texas Transportation Code Chapter 547 (Texas Statutes)\",\n      \t\"url\": \"https://statutes.capitol.texas.gov/Docs/TN/htm/TN.547.htm\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Texas DPS, Red, White or Blue Lights (private security guidance)\",\n      \t\"url\": \"https://www.dps.texas.gov/section/private-security/red-white-or-blue-lights\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"Texas Transportation Code Chapter 546, operation of authorized emergency vehicles\",\n      \t\"url\": \"https://statutes.capitol.texas.gov/Docs/TN/htm/TN.546.htm\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 630\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#webpage\",\n  \t\"url\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws\",\n  \t\"name\": \"Texas Emergency Vehicle Light Laws (2026 Guide)\",\n  \t\"description\": \"Transportation Code 547.305 and 547.702 by class, plus the HB 2812 rule limiting security patrol vehicles to green, amber or white. Reviewed September 2026.\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/#website\"\n  \t},\n  \t\"breadcrumb\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#breadcrumb\"\n  \t},\n  \t\"lastReviewed\": \"2026-09-08\",\n  \t\"reviewedBy\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"inLanguage\": \"en-US\"\n\t},\n\t{\n  \t\"@type\": \"BreadcrumbList\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#breadcrumb\",\n  \t\"itemListElement\": [\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 1,\n      \t\"name\": \"Home\",\n      \t\"item\": \"https://strobesnmore.com/\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 2,\n      \t\"name\": \"Informative Blogs\",\n      \t\"item\": \"https://strobesnmore.com/blogs/informative\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 3,\n      \t\"name\": \"Texas Emergency Vehicle Light Laws\"\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"FAQPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/texas-emergency-vehicle-light-laws#faq\",\n  \t\"mainEntity\": [\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"What color lights can security vehicles use in Texas?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Green, amber or white. Texas Transportation Code § 547.305 was amended by HB 2812 of the 85th Legislature, Regular Session, to limit security patrol vehicles to those colors.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Can volunteer firefighters use emergency lights on a personal vehicle in Texas?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Yes. Texas Transportation Code § 547.305(d) includes the private vehicle of a volunteer firefighter or a certified emergency medical services employee or volunteer responding to a fire alarm or medical emergency. Under § 546.004(a), the operating privileges apply only while using visual signals meeting the requirements of §§ 547.305 and 547.702.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Are red lights illegal on the front of a vehicle in Texas?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Texas Transportation Code § 547.305(b) prohibits any vehicle other than a police vehicle from displaying a red light visible from directly in front of the center of the vehicle, except as expressly authorized by law.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"When can a Texas tow truck use flashing lights?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Under § 547.305(d), while under the direction of a law enforcement officer at the scene of a collision, while hooking up to a disabled vehicle on a roadway, or where the tow truck has a mounted light bar that includes turn signals and stop lamps in addition to those required by §§ 547.322, 547.323 and 547.324.\"\n      \t}\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"Organization\",\n  \t\"@id\": \"https://strobesnmore.com/#organization\",\n  \t\"name\": \"Strobes N' More\",\n  \t\"url\": \"https://str