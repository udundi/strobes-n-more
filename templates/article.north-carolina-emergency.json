      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n\t{\n  \t\"@type\": \"BlogPosting\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#article\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"mainEntityOfPage\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#webpage\"\n  \t},\n  \t\"headline\": \"New Jersey Emergency Vehicle Light Laws: Blue Light Permits and the Amended Light Bar Rule\",\n  \t\"description\": \"NJ blue light rules under 39:3-54.7 et seq., including the amended specification that now permits permanently mounted light bars. Reviewed August 2026.\",\n  \t\"abstract\": \"N.J.S.A. 39:3-54.9 has been amended. Emergency warning lights in New Jersey may now be removable or permanently attached and may be blue light-bar type, in accordance with specifications prescribed by the chief administrator. The 7.5-inch diameter limit and 51 candlepower limit widely cited for New Jersey volunteer warning lights appear in a superseded version of N.J.S.A. 39:3-54.9 and are not in the current text. New Jersey assigns blue to rank and file volunteer members and red to volunteer fire chiefs and first assistant chiefs. Reversing the two is a common and visible compliance error. Eligible to mount blue warning lights under N.J.S.A. 39:3-54.7 are active members in good standing of a volunteer fire company, a volunteer first aid or rescue squad, or a county or municipal volunteer Office of Emergency Management whose official duties include responding to a fire or emergency call. Under N.J.S.A. 39:3-54.8, New Jersey emergency warning lights may be operated only while the vehicle is being used in answering a fire or emergency call. The Chief Administrator of the New Jersey Motor Vehicle Commission may not require a member to specify which motor vehicles the emergency warning light may be mounted on.\",\n  \t\"speakable\": {\n    \t\"@type\": \"SpeakableSpecification\",\n    \t\"cssSelector\": [\n      \t\".key-takeaways\",\n      \t\"h1\"\n    \t]\n  \t},\n  \t\"inLanguage\": \"en-US\",\n  \t\"datePublished\": \"2026-09-08\",\n  \t\"dateModified\": \"2026-09-08\",\n  \t\"author\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"publisher\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"about\": [\n    \t{\n      \t\"@type\": \"Thing\",\n      \t\"name\": \"New Jersey emergency vehicle lighting law\"\n    \t},\n    \t{\n      \t\"@type\": \"Legislation\",\n      \t\"name\": \"N.J.S.A. 39:3-54.7 et seq.\",\n      \t\"jurisdiction\": {\n        \t\"@type\": \"AdministrativeArea\",\n        \t\"name\": \"New Jersey\"\n      \t},\n      \t\"legislationJurisdiction\": \"US-NJ\"\n    \t}\n  \t],\n  \t\"citation\": [\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"NJ Division of Fire Safety, Fire Service Reference Booklet 5: Emergency Lights\",\n      \t\"url\": \"https://www.nj.gov/dca/dfs/pdf/Ref%20Booklets/emergency%20lights%20booklet%205.pdf\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"New Jersey Motor Vehicle Commission\",\n      \t\"url\": \"https://www.nj.gov/mvc/\"\n    \t},\n    \t{\n      \t\"@type\": \"CreativeWork\",\n      \t\"name\": \"New Jersey Legislature statute search\",\n      \t\"url\": \"https://pub.njleg.gov/\"\n    \t}\n  \t],\n  \t\"image\": {\n    \t\"@type\": \"ImageObject\",\n    \t\"url\": \"REPLACE_WITH_FEATURED_IMAGE_URL\",\n    \t\"width\": 1200,\n    \t\"height\": 630\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#webpage\",\n  \t\"url\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws\",\n  \t\"name\": \"New Jersey Emergency Vehicle Light Laws (2026 Guide)\",\n  \t\"description\": \"NJ blue light rules under 39:3-54.7 et seq., including the amended specification that now permits permanently mounted light bars. Reviewed August 2026.\",\n  \t\"isPartOf\": {\n    \t\"@id\": \"https://strobesnmore.com/#website\"\n  \t},\n  \t\"breadcrumb\": {\n    \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#breadcrumb\"\n  \t},\n  \t\"lastReviewed\": \"2026-09-08\",\n  \t\"reviewedBy\": {\n    \t\"@id\": \"https://strobesnmore.com/#organization\"\n  \t},\n  \t\"inLanguage\": \"en-US\"\n\t},\n\t{\n  \t\"@type\": \"BreadcrumbList\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#breadcrumb\",\n  \t\"itemListElement\": [\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 1,\n      \t\"name\": \"Home\",\n      \t\"item\": \"https://strobesnmore.com/\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 2,\n      \t\"name\": \"Informative Blogs\",\n      \t\"item\": \"https://strobesnmore.com/blogs/informative\"\n    \t},\n    \t{\n      \t\"@type\": \"ListItem\",\n      \t\"position\": 3,\n      \t\"name\": \"New Jersey Emergency Vehicle Light Laws\"\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"FAQPage\",\n  \t\"@id\": \"https://strobesnmore.com/blogs/informative/new-jersey-emergency-vehicle-light-laws#faq\",\n  \t\"mainEntity\": [\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Can New Jersey volunteer firefighters use a light bar?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"The current text of N.J.S.A. 39:3-54.9 provides that emergency warning lights shall be removable or permanently attached, of the flashing or revolving type with a blue lens, or shall be blue of the light bar type in accordance with specifications prescribed by the chief administrator. Older guidance describing a 7.5-inch and 51-candlepower limit on temporarily attached lights reflects a prior version.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"What color light do New Jersey volunteer firefighters use?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"Blue. Active members in good standing of a volunteer fire company, volunteer first aid or rescue squad, or county or municipal volunteer OEM may mount blue emergency warning lights under N.J.S.A. 39:3-54.7. Volunteer fire chiefs and first assistant chiefs use red.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"When can New Jersey blue lights be used?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"N.J.S.A. 39:3-54.8 limits operation to while the vehicle is being used in answering a fire or emergency call, and no other time.\"\n      \t}\n    \t},\n    \t{\n      \t\"@type\": \"Question\",\n      \t\"name\": \"Does a New Jersey blue light give right of way?\",\n      \t\"acceptedAnswer\": {\n        \t\"@type\": \"Answer\",\n        \t\"text\": \"No. A member displaying emergency warning lights must drive with due regard for the safety of all persons and obey all traffic laws of the State.\"\n      \t}\n    \t}\n  \t]\n\t},\n\t{\n  \t\"@type\": \"Organization\",\n  \t\"@id\": \"https://strobesnmore.com/#organization\",\n  \t\"name\": \"Strobes N' More\",\n  \t\"url\": \"https://strobesnmore.com/\",\n  \t\"telephone\": \"+1-401-454-4487\",\n  \t\"email\": \"sales@strobesnmore.com\",\n  \t\"address\": {\n    \t\"@type\": \"PostalAddress\",\n    \t\"streetAddress\": \"81 Tom Harvey Road\",\n    \t\"addressLocality\": \"Westerly\",\n    \t\"addressRegion\": \"RI\",\n    \t\"postalCode\": \"02891\",\n    \t\"addressCountry\": \"US\"\n  \t}\n\t},\n\t{\n  \t\"@type\": \"WebSite\",\n  \t\"@id\": \"https://strobesnmore.com/#website\",\n  \t\"url\": \"https://stro